{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "date",
  "title": "Date",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time represented by this value"
    },
    "zone": {
      "type": "string",
      "description": "Time zone identifier associated with the date"
    }
  },
  "required": [
    "date",
    "zone"
  ],
  "additionalProperties": false
}
